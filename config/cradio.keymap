#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#ifndef KEYMAP_DRAWER

#include "keys_de.h"

#endif

&sk {
    lazy;
    quick-release;
    release-after-ms = <900>;
};

&lt { quick-tap-ms = <220>; };

/ {
    behaviors {
        qexcl: qmark_excl {
            compatible = "zmk,behavior-mod-morph";
            display-name = "SM Qmark-Excl";
            #binding-cells = <0>;
            bindings = <&kp DE_QMARK>, <&kp DE_EXCL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        alt_tabber: swapper {
            compatible = "zmk,behavior-tri-state";
            display-name = "Alt-Tabber";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;

            ignored-key-positions = <7 16 17 18>; // arrow keys
        };
    };

    macros {
        bts: bts {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "BT Switch + Select";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEF";
            bindings = <
&kp Q     &kp W  &kp E  &kp R      &kp T            &kp DE_Z                   &kp U        &kp I                 &kp O             &kp P
&kp A     &kp S  &kp D  &kp F      &kp G            &kp H                      &kp J        &kp K                 &kp L             &sl 4
&kp DE_Y  &kp X  &kp C  &kp V      &kp B            &kp N                      &kp M        &kp RS(DE_SEMICOLON)  &kp RS(DE_COLON)  &qexcl
                        &lt 1 TAB  &mt LCTRL SPACE  &mt RIGHT_SHIFT BACKSPACE  &lt 2 ENTER
            >;
        };

        navigation_layer {
            display-name = "NAV";
            bindings = <
&kp ESC   &alt_tabber  &none      &none   &none     &kp DE_N7  &kp DE_N8  &kp DE_N9  &none  &none
&sk LGUI  &sk LALT     &sk LCTRL  &none   &sk RALT  &kp DE_N4  &kp DE_N5  &kp DE_N6  &none  &none
&none     &none        &none      &none   &none     &kp DE_N1  &kp DE_N2  &kp DE_N3  &none  &none
                                  &trans  &trans    &trans     &trans
            >;
        };

        symbol1_layer {
            display-name = "SYM1";
            bindings = <
&kp ESCAPE  &none         &none        &none        &none        &none         &none         &none        &none        &none
&kp DE_LT   &kp DE_PRCNT  &kp DE_LPAR  &kp DE_LBRC  &kp DE_LBKT  &kp DE_EQUAL  &kp DE_PLUS   &kp DE_STAR  &kp DE_AT    &kp DE_DQT
&kp DE_GT   &kp DE_HASH   &kp DE_RPAR  &kp DE_RBRC  &kp DE_RBKT  &kp DE_UNDER  &kp DE_MINUS  &kp DE_FSLH  &kp DE_BSLH  &kp DE_SQT
                                       &trans       &trans       &trans        &trans
            >;
        };

        symbol2_layer {
            display-name = "SYM2";
            bindings = <
&kp F1        &kp F2        &kp F3       &kp F4       &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp DE_SECT   &kp DE_DEG    &kp DE_PIPE  &kp DE_AMPS  &trans  &trans  &trans  &trans  &trans  &kp F11
&kp DE_CARET  &kp DE_TILDE  &kp DE_EURO  &kp DE_DLLR  &trans  &trans  &trans  &trans  &trans  &kp F12
                                         &trans       &trans  &trans  &trans
            >;
        };

        international_layer {
            display-name = "INT";
            bindings = <
&trans           &trans     &trans        &trans        &trans       &trans  &kp DE_U_UMLAUT  &trans  &kp DE_O_UMLAUT  &trans
&kp DE_A_UMLAUT  &kp DE_SZ  &kp DE_ACUTE  &kp DE_GRAVE  &trans       &trans  &trans           &trans  &trans           &trans
&trans           &trans     &trans        &trans        &bootloader  &trans  &trans           &trans  &trans           &trans
                                          &trans        &trans       &trans  &trans
            >;
        };
    };
};
